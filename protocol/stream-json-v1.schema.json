        },
        {
          "$ref": "#/$defs/teamExecutionEvent"
        },
        {
          "$ref": "#/$defs/recoveryEvent"
        },
        {
          "$ref": "#/$defs/recoveryActionEvent"
        },
        {
          "$ref": "#/$defs/taskExecutionEvent"
        },
        {
          "$ref": "#/$defs/taskExecutionReportEvent"
        },
        {
          "$ref": "#/$defs/localCommandEvent"
        },
        {
          "$ref": "#/$defs/recoverySuggestionEvent"
        },
        {
          "$ref": "#/$defs/taskListEvent"
        },
        {
          "$ref": "#/$defs/taskShowEvent"
        },
        {
          "$ref": "#/$defs/taskStatusEvent"
        },
        {
