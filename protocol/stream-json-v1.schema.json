        "tool_use",
        "tool_result",
        "done",
        "session_meta",
        "message_start",
        "message_stop",
        "command_match",
        "tool_match",
        "permission_denial",
        "permission_request",
        "reasoning_step",
        "decisioning_event",
        "plan_execution_event",
        "task_ledger_event",
        "model_route_event",
        "team_execution_event",
        "recovery_event",
