    "baseEvent": {
      "type": "object",
      "required": [
        "type",
        "protocol_version"
      ],
      "additionalProperties": true,
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "schema_version": {
          "type": "number"
        }
      }
    },
    "messageStartEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "properties": {
            "type": {
              "const": "message_start"
            }
          }
        }
      ]
    },
    "messageStopEvent": {
      "allOf": [
