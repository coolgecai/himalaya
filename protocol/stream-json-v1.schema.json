        "route_optimizer_report",
        "route_optimizer_replay",
        "route_policy_proposal",
        "route_policy_apply",
        "route_policy_rollback",
        "route_policy_list",
        "policy_review",
        "policy_ledger",
        "benchmark_suite",
        "benchmark_task",
        "benchmark_run",
        "benchmark_autonomous",
        "worker_list",
        "worker_create",
        "worker_spawn",
        "worker_probe",
        "worker_observe",
        "worker_ready",
        "worker_resolve_trust",
        "worker_prompt",
        "worker_complete",
        "worker_restart",
        "worker_terminate",
        "worker_supervisor_tick",
        "error",
        "context_event",
        "user_question"
