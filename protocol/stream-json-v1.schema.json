{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himalaya.local/protocol/stream-json-v1.schema.json",
  "title": "Himalaya stream-json event v1",
  "description": "Schema for one NDJSON line emitted by the Himalaya CLI when --output-format stream-json is enabled.",
  "type": "object",
  "required": [
    "type",
    "protocol_version"
  ],
  "additionalProperties": true,
  "properties": {
    "type": {
      "$ref": "#/$defs/eventType"
    },
    "protocol_version": {
      "description": "Current stream protocol version emitted by Rust CLI.",
      "const": 1
    },
    "schema_version": {
      "description": "Legacy VS Code fallback; prefer protocol_version.",
      "type": "number"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "$ref": "#/$defs/messageStartEvent"
        },
        {
          "$ref": "#/$defs/messageStopEvent"
        },
        {
          "$ref": "#/$defs/textDeltaEvent"
        },
        {
          "$ref": "#/$defs/toolUseEvent"
        },
